<Window x:Class="_9.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Битва" Height="400" Width="650"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="бойня" 
                   FontSize="16" 
                   HorizontalAlignment="Center"
                   Grid.Row="0" Margin="5"/>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Border BorderBrush="Gray" BorderThickness="1" Padding="5" Margin="5" Width="180">
                <StackPanel>
                    <Image Source="/Images/slavyanovka.jpg" Width="80" Height="80" Margin="5"/>
                    <TextBlock Text="{Binding Warriors[0].Name}" FontWeight="Bold"  HorizontalAlignment="Center"/>
                    <ProgressBar Value="{Binding Warriors[0].Health}" Minimum="0" Maximum="100" Height="15" Margin="2"/>
                    <Button Content="бить" Click="AttackButton_Click" CommandParameter="{Binding Warriors[0]}" Margin="2" Padding="5"/>
                </StackPanel>
            </Border>
            <Border BorderBrush="Gray" BorderThickness="1" Padding="5" Margin="5" Width="180">
                <StackPanel>
                    <Image Source="/Images/pkps.jpg" Width="80" Height="80" Margin="5"/>
                    <TextBlock Text="{Binding Warriors[1].Name}" FontWeight="Bold" HorizontalAlignment="Center"/>
                    <ProgressBar Value="{Binding Warriors[1].Health}" Minimum="0" Maximum="150" Height="15" Margin="2"/>
                    <Button Content="бить" Click="AttackButton_Click" CommandParameter="{Binding Warriors[1]}" Margin="2" Padding="5"/>
                </StackPanel>
            </Border>
            <Border BorderBrush="Gray" BorderThickness="1" Padding="5" Margin="5" Width="180">
                <StackPanel>
                    <Image Source="/Images/avik.jpg" Width="80" Height="80" Margin="5"/>
                    <TextBlock Text="{Binding Warriors[2].Name}" FontWeight="Bold" HorizontalAlignment="Center"/>
                    <ProgressBar Value="{Binding Warriors[2].Health}" Minimum="0" Maximum="50" Height="15" Margin="2"/>
                    <Button Content="бить" Click="AttackButton_Click" CommandParameter="{Binding Warriors[2]}" Margin="2" Padding="5"/>
                </StackPanel>
            </Border>
        </StackPanel>
        <ListBox x:Name="LogList" Grid.Row="2" Height="100" Margin="5"/>
    </Grid>
</Window>